# Safe production shape. Store real secret values in the deployment platform,
# never in this file or in Git.
APP_ENV=production
HOST=0.0.0.0
PORT=8000
# Set to the deployment ingress proxy address/range.
FORWARDED_ALLOW_IPS=127.0.0.1
LOG_LEVEL=INFO

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_at_deployment
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Set these to the provider's current prices so cost metrics are meaningful.
DEEPSEEK_INPUT_COST_PER_MTOK=0
DEEPSEEK_CACHED_INPUT_COST_PER_MTOK=0
DEEPSEEK_OUTPUT_COST_PER_MTOK=0
LLAMA_PARSE_API=replace_at_deployment

DATABASE_URL=postgresql://user:replace_at_deployment@database:5432/genexam?sslmode=require
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

QDRANT_URL=https://qdrant.example.com
QDRANT_API_KEY=replace_at_deployment
QDRANT_VERIFY_TLS=true
QDRANT_COLLECTION=genexam

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/app/data/storage

SESSION_COOKIE_NAME=__Host-genexam_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_HASH_PEPPER=replace_with_a_long_random_secret
SESSION_TTL_SECONDS=604800

CLERK_PUBLISHABLE_KEY=pk_live_replace_at_deployment
CLERK_SECRET_KEY=sk_live_replace_at_deployment
# Optional PEM public key for networkless token verification.
CLERK_JWT_KEY=
# Optional; ClerkJS derives it from the publishable key when blank.
CLERK_FRONTEND_API_URL=
CLERK_AUTHORIZED_PARTIES=https://exam.example.com

CORS_ALLOW_ORIGINS=https://exam.example.com
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Idempotency-Key,X-Request-ID,Authorization
ALLOWED_HOSTS=exam.example.com,api.example.com
METRICS_TOKEN=replace_with_a_long_random_bearer_token
ENABLE_LEGACY_SYNC_API=false
REQUIRE_IDEMPOTENCY_KEY=true

# Exams are retained permanently. These settings only cover regenerable or
# abandoned resources.
ABANDONED_UPLOAD_AFTER_SECONDS=86400
TERMINAL_JOB_RETENTION_DAYS=30
TEMP_EXPORT_RETENTION_SECONDS=86400
CLEANUP_BATCH_SIZE=100
ORPHAN_SCAN_MAX_POINTS=10000
