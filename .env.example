# LlamaParse API key (required for PDF parsing)
LLAMA_PARSE_API=your_llama_parse_api_key

# Qdrant server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=genexam

# LM Studio LLM
LMS_URL=http://127.0.0.1:1234
LMS_MODEL=mistralai/mistral-7b-instruct-v0.3

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Storage
UPLOAD_DIR=data/uploads
REGISTRY_FILE=data/documents.json

# Logging
LOG_LEVEL=INFO

# Google Forms export (optional)
GOOGLE_FORMS_ENABLED=false
# Place your OAuth desktop client file here manually (never committed):
#   data/google_forms/oauth_client.json
GOOGLE_OAUTH_CLIENT_FILE=data/google_forms/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=data/google_forms/token.json
GOOGLE_FORMS_QUESTIONS_PER_PAGE=0
GOOGLE_FORMS_POINTS=1

# --- Google Forms ownership mode: teacher | central | disabled ---
GOOGLE_FORMS_MODE=teacher
# Web application OAuth client (teacher sign-in + teacher-owned Forms):
GOOGLE_WEB_OAUTH_CLIENT_ID=
GOOGLE_WEB_OAUTH_CLIENT_SECRET=
GOOGLE_WEB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Session signing key. Leave unset in dev = random per boot (restarts log everyone out).
SESSION_SECRET=
