# Runtime profile
APP_ENV=local
FORWARDED_ALLOW_IPS=127.0.0.1

# LlamaParse API key (required for PDF parsing)
LLAMA_PARSE_API=your_llama_parse_api_key

# Qdrant server
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=genexam
QDRANT_TIMEOUT_SECONDS=30
QDRANT_API_KEY=
QDRANT_VERIFY_TLS=true

# LLM provider: local (default) or deepseek
LLM_PROVIDER=local

# Existing local LM Studio LLM
LMS_URL=http://127.0.0.1:1234
LMS_MODEL=mistralai/mistral-7b-instruct-v0.3

# DeepSeek API (used only when LLM_PROVIDER=deepseek)
# Put the real key in .env, which is ignored by Git. Never commit it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONCURRENCY_LIMIT=4
DEEPSEEK_MAX_STRUCTURED_ATTEMPTS=3
DEEPSEEK_MAX_TRANSIENT_RETRIES=2
DEEPSEEK_RETRY_BASE_SECONDS=1.0
# Set current provider prices when cost estimation is required.
DEEPSEEK_INPUT_COST_PER_MTOK=0
DEEPSEEK_CACHED_INPUT_COST_PER_MTOK=0
DEEPSEEK_OUTPUT_COST_PER_MTOK=0

# Embedding model
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Storage
UPLOAD_DIR=data/uploads
REGISTRY_FILE=data/documents.json
LEGACY_EXAM_DIR=data/legacy_exams
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=data/storage

# Anonymous sessions
SESSION_COOKIE_NAME=genexam_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=604800
SESSION_TOKEN_BYTES=32
# Set a long random value in production. Changing it invalidates current cookies.
SESSION_HASH_PEPPER=change_me

# Clerk account authentication. The publishable key is browser-safe; the
# secret key must remain server-side and outside Git.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWT_KEY=
CLERK_FRONTEND_API_URL=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000

# Redis + Celery local job queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
# Temporary compatibility switch for old synchronous /upload and /generate.
# Keep false for normal use and deployment.
ENABLE_LEGACY_SYNC_API=false

# Server-side limits
MAX_UPLOAD_BYTES=104857600
MAX_QUESTIONS_PER_GENERATION=150
MAX_MODELS_PER_GENERATION=4
MAX_ACTIVE_GENERATION_JOBS_PER_SESSION=2
MAX_CHILD_IDS_PER_GENERATION=1000
MAX_LOGO_BYTES=2097152
GENERATION_REQUESTS_PER_MINUTE=2
IDEMPOTENCY_KEY_MAX_LENGTH=200
IDEMPOTENCY_TTL_SECONDS=86400
REQUIRE_IDEMPOTENCY_KEY=false
PARSING_TIMEOUT_SECONDS=120
GENERATION_TIMEOUT_SECONDS=420
JOB_HEARTBEAT_SECONDS=30
JOB_STALE_AFTER_SECONDS=480
ABANDONED_UPLOAD_AFTER_SECONDS=86400
TERMINAL_JOB_RETENTION_DAYS=30
TEMP_EXPORT_RETENTION_SECONDS=86400
CLEANUP_BATCH_SIZE=100
ORPHAN_SCAN_MAX_POINTS=10000

# PostgreSQL application state and evaluation history
DATABASE_URL=postgresql://postgres:your_password@localhost:1966/draftwork
# Used by Docker Compose for its PostgreSQL container.
POSTGRES_PASSWORD=your_password
POSTGRES_PORT=1966
REDIS_PORT=6379
QDRANT_PORT=6333

# Logging
LOG_LEVEL=INFO
METRICS_TOKEN=
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
CORS_ALLOW_METHODS=GET,POST,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Idempotency-Key,X-Request-ID,Authorization
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
